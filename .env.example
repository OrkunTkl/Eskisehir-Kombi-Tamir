# Kopyalayın: .env.local  (Vercel'de aynı değişkenleri Project > Settings > Environment Variables'a girin)
NEXT_PUBLIC_SITE_URL=https://eskisehir-kombi-tamir.vercel.app
NEXT_PUBLIC_PHONE=05394061900
# Boşsa telefon numarası WhatsApp için de kullanılır
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_LEADS_ENABLED=false
NEXT_PUBLIC_REVIEWS_ENABLED=false
# İsteğe bağlı: KVKK sayfasında görünür (boşsa satır gösterilmez)
NEXT_PUBLIC_CONTROLLER_NAME=
NEXT_PUBLIC_CONTROLLER_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=
# İsteğe bağlı: Google Search Console HTML etiketi doğrulaması
NEXT_PUBLIC_GSC_VERIFICATION=
